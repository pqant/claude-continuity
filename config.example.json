{
  "enabled": true,
  "window_tokens": 262144,
  "warn_ratio": 0.55,
  "rotate_ratio": 0.62,
  "hard_ratio": 0.72,
  "full_auto": true,
  "settle_ms": 1500,
  "boundary_command_regex": "(pytest|cargo (test|build)|npm (run )?(test|build|lint)|go (test|build|vet)|make\\b|tsc\\b|ruff|mypy)",
  "git_snapshot": true,
  "snapshot_retention": 20,
  "handoff_max_words": 5000,
  "inline_handoff_max_chars": 12000,
  "notify_command": null,
  "notify_endpoint": "https://ntfy.sh/your-topic",
  "notify_enabled": false,
  "unattended": false,
  "statusline_ansi": true,
  "progress_type": 0,
  "watchdog_enabled": false,
  "watchdog_health_url": "http://<LLM-HOST>:8000/health",
  "watchdog_interval_s": 300,
  "watchdog_stale_minutes": 45,
  "watchdog_max_nudges": 3,
  "watchdog_nudge_text": "Continue.",
  "watchdog_nudge_only_most_recent": false,
  "watchdog_frozen_nudge_minutes": 20,
  "watchdog_gen_probe_timeout_s": 180,
  "watchdog_network_recovery_cmd": "",
  "power_plug_ip": "",
  "power_plug_port": 9999,
  "power_cycle_off_s": 8,
  "power_cycle_after_s": 600,
  "power_cycle_cooldown_s": 1800,
  "watchdog_digest_push_cap_s": 300,
  "redact_patterns": [
    "(?i)(api[_-]?key|token|secret|password)\\s*[=:]\\s*\\S+",
    "sk-[A-Za-z0-9]{20,}",
    "ghp_[A-Za-z0-9]{30,}"
  ],
  "redact_patterns_extra": [],
  "log_level": "info",
  "session_end_push_suppress_projects": []
}
